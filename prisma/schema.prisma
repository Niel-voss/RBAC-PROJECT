// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // The POOLED connection string
  directUrl = env("DIRECT_URL") // The UNPOOLED connection string
}

// ------------------------------------------------------
// 1. ENUMS
// ------------------------------------------------------

enum Role {
  STUDENT
  LECTURER
  ADMIN
}

// ------------------------------------------------------
// 2. CENTRAL AUTHENTICATION MODEL
// ------------------------------------------------------
// This handles all login, security, and role-checking.

model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
  role     Role   @default(STUDENT)

  // Standard Production Security Fields
  isVerified         Boolean   @default(false)
  verificationToken  String?   @unique
  resetPasswordToken String?   @unique
  tokenExpiry        DateTime?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations to the specific role profiles
  studentProfile  Student?
  lecturerProfile Lecturer?
  adminProfile    Admin?
}

// ------------------------------------------------------
// 3. ROLE PROFILES
// ------------------------------------------------------
// These hold the specific data for each role.

model Student {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Specific Student Fields
  studentName         String
  matriculationNumber String @unique
  department          String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cgpa      Float?   @default(0.0)
}

model Lecturer {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Specific Lecturer Fields
  lecturerName String
  course       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Admin {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Specific Admin Fields
  adminName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String // e.g., "UPDATE_CGPA", "CREATE_USER", "SUSPEND_USER"
  actor     String // e.g., "Lecturer John Doe" or "Admin Admin"
  target    String // e.g., "Student Jane Smith"
  details   String? // e.g., "Changed CGPA to 4.5"
  createdAt DateTime @default(now())
}
